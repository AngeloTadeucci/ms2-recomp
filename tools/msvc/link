#!/bin/sh
# Pins the project Wine prefix: ninja runs compilers long after cmake configured, without its ENV{WINEPREFIX}.
R=$(cd "$(dirname "$0")/../.." && pwd)
export WINEPREFIX="${MS2_MSVC_WINEPREFIX:-$R/work/wineprefix-msvc}" WINEDEBUG="${WINEDEBUG:--all}"
exec "$R/third_party/msvc/bin/x64/link" "$@"
